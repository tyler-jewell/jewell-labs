{
  "name": "@jewell-labs/paperclip-plugin-sendblue",
  "version": "0.1.0",
  "description": "SendBlue (iMessage/SMS) connector plugin for Paperclip — outbound tools, inbound webhooks, notify-on-events, allowlists.",
  "type": "module",
  "license": "MIT",
  "author": "jewell-labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyler-jewell/jewell-labs.git",
    "directory": "plugins/paperclip-plugin-sendblue"
  },
  "homepage": "https://github.com/tyler-jewell/jewell-labs/tree/main/plugins/paperclip-plugin-sendblue#readme",
  "bugs": {
    "url": "https://github.com/tyler-jewell/jewell-labs/issues"
  },
  "keywords": [
    "paperclip",
    "paperclip-plugin",
    "sendblue",
    "imessage",
    "sms",
    "messaging"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist coverage",
    "version:check": "node ./scripts/version-check.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "deadcode": "knip --no-config-hints --exclude exports,types,nsExports,classMembers,enumMembers,duplicates",
    "deadcode:all": "knip --no-config-hints",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run version:check && tsc && node ./scripts/build-ui.mjs",
    "dev": "tsc --watch",
    "check": "node ./scripts/check.mjs",
    "release": "node ./scripts/release.mjs",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@paperclipai/plugin-sdk": "*",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@paperclipai/plugin-sdk": "^2026.707.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.30.0",
    "globals": "^16.3.0",
    "knip": "^5.61.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  }
}
